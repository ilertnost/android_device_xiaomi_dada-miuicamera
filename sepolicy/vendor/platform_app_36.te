# Android 17 assigns platform-signed apps targeting SDK 36 to platform_app_36
# instead of platform_app. Keep the MIUI Camera vendor access equivalent.
binder_use(platform_app_36)
binder_call(platform_app_36, hal_camera_default)
binder_call(platform_app_36, hal_hypsys_vendor)
binder_call(platform_app_36, hal_misyscore_default)
hal_client_domain(platform_app_36, vendor_hal_qspmhal)

allow platform_app_36 hal_aidlbgservice_service:service_manager find;
allow platform_app_36 hal_misys_service:service_manager find;
allow platform_app_36 hal_misyscore_service:service_manager find;

allow platform_app_36 adsprpcd_file:dir { getattr open read search watch };
allow platform_app_36 vendor_miuicamera_dsp_file:dir { getattr open read search watch };

allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

# Camera diagnostics and app-side AI initialization.
allow platform_app_36 vendor_miev_device:chr_file rw_file_perms;

# MIUI Camera samples PSI data to adapt its workload to system pressure.
allow platform_app_36 proc_pressure_cpu:file r_file_perms;
allow platform_app_36 proc_pressure_io:file r_file_perms;
allow platform_app_36 proc_pressure_mem:file r_file_perms;

# Properties
get_prop(platform_app_36, vendor_audio_prop)
get_prop(platform_app_36, vendor_camera_p3enable_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)
get_prop(platform_app_36, vendor_display_prop)
get_prop(platform_app_36, vendor_displayfeature_prop)
get_prop(platform_app_36, vendor_panel_info_prop)

# Optional MIUI-only properties are absent on AOSP.
dontaudit platform_app_36 vendor_default_prop:file { getattr map open read };
